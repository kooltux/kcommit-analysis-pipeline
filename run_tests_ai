#!/usr/bin/env python3
"""Smoke-test a generated serve_ai.pyz over loopback with curl."""
import hashlib
import io
import json
import os
from pathlib import Path
import re
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import zipfile


def check(condition, message):
    if not condition:
        raise AssertionError(message)


def color_enabled(stream=None, environ=None):
    stream = sys.stdout if stream is None else stream
    environ = os.environ if environ is None else environ
    return 'NO_COLOR' not in environ and bool(stream.isatty())


def paint(text, code, *, enabled=None):
    if enabled is None:
        enabled = color_enabled()
    return f'\033[{code}m{text}\033[0m' if enabled else text


def preview(data, limit=160):
    """Bound single-line output while showing readable request/response bytes."""
    text = data.decode('utf-8', errors='replace').replace('\r', '\\r').replace('\n', '\\n')
    return text[:limit] + ('...' if len(text) > limit else '')


def format_exchange(method, path, actual, expected, body, *, data=None, binary=False,
                    reason=None, enabled=None):
    request = f'> {method} {path}'
    if data is not None:
        request += f' | JSON {preview(data)}'
    matched = actual == expected
    label = 'EXPECTED' if matched and expected >= 400 else 'OK' if matched else 'FAIL'
    status = f'< {label} HTTP {actual} (expected {expected})'
    if reason:
        status += f' — {reason}'
    if binary:
        detail = f'{len(body)} bytes (ZIP; contents checked below)'
    elif expected >= 400 and matched:
        detail = f'{len(body)} bytes (expected rejection; HTML body omitted)'
    else:
        detail = f'{len(body)} bytes | {preview(body)}'
    return paint(request, '36', enabled=enabled), paint(f'{status} | {detail}',
        '33' if matched and expected >= 400 else '32' if matched else '31', enabled=enabled)


def curl(base, path, *, method='GET', data=None):
    command = ['curl', '--silent', '--show-error', '--noproxy', '*', '--max-time', '5',
               '--output', '-', '--write-out', '\n%{http_code}', '-X', method]
    if data is not None:
        command += ['-H', 'Content-Type: application/json', '--data-binary', '@-']
    command.append(base + path)
    result = subprocess.run(command, input=data, capture_output=True, timeout=8)
    check(result.returncode == 0, f'curl {method} {path}: {result.stderr.decode(errors="replace")}')
    body, status = result.stdout.rsplit(b'\n', 1)
    return int(status), body


def expect(base, path, status=200, *, method='GET', data=None, binary=False, reason=None):
    code, body = curl(base, path, method=method, data=data)
    request, response = format_exchange(method, path, code, status, body,
        data=data, binary=binary, reason=reason)
    print(request, flush=True)
    print(response, flush=True)
    check(code == status, f'{method} {path}: expected {status}, got {code}: {body[:300]!r}')
    return body


def check_pages(base, endpoint, full, fields):
    """Compare paginated responses with independent slices of the full listing."""
    end = len(full[fields[0]]) + 1
    cases = [('limit=1', 0, 1), ('offset=1', 1, None),
             ('limit=1&offset=1', 1, 1), ('limit=0', 0, None),
             ('limit=-1&offset=-1', 0, None), ('limit=bad&offset=bad', 0, None),
             ('limit=&offset=', 0, None), ('limit=1.5&offset=1.5', 0, None),
             ('limit=1_0', 0, None), ('limit=1&limit=2', 0, 1),
             (f'limit=1&offset={end}', end, 1), (f'limit={end}', 0, end)]
    for query, offset, limit in cases:
        page = json.loads(expect(base, endpoint + '?' + query))
        expected = dict(full)
        for field in fields:
            expected[field] = full[field][offset:offset + limit if limit else None]
        check(page == expected, f'Pagination or metadata mismatch: {endpoint}?{query}')


def check_discovery(base, expected_version=None):
    """Exercise live API, batch discovery and pagination; return the full chunk list."""
    api = json.loads(expect(base, '/api'))
    check(isinstance(api.get('routes'), list), 'Missing API routes')
    routes = {(r['method'], r['path']): r for r in api['routes']}
    check(('GET', '/api') in routes, 'API must describe itself')
    check(('GET', '/api/version') in routes, 'Missing version route')
    version = json.loads(expect(base, '/api/version'))
    check(isinstance(version.get('tool_version'), str) and bool(version['tool_version'].strip()),
          'Invalid tool version')
    check(version.get('version_source') == 'MANIFEST.json' and
          version.get('captured_at') == 'zipapp_generation', 'Invalid version provenance')
    if expected_version is not None:
        check(version == expected_version, 'Reported version differs from the generated zipapp')
    check(json.loads(expect(base, '/api/version?limit=1&offset=999')) == version,
          'Version endpoint must not be paginated')
    for path in ('/batches', '/chunks', '/batch/<batch_id>'):
        check(('GET', path) in routes, 'Missing discovery route: ' + path)
        check(set(routes[('GET', path)].get('query_parameters', {})) == {'limit', 'offset'},
              'Missing pagination contract: ' + path)
    check('query_parameters' not in routes[('GET', '/api')], 'API must not advertise pagination')
    chunks = json.loads(expect(base, '/chunks'))
    batches = json.loads(expect(base, '/batches'))
    check(isinstance(chunks.get('chunks'), list), 'Invalid chunk listing')
    check(isinstance(batches.get('batches'), list), 'Invalid batch listing')
    check(api['run_id'] == batches['run_id'] == chunks['run_id'], 'Discovery run IDs differ')
    check(batches['total_batches'] == len(batches['batches']), 'Incorrect total batch count')
    check_pages(base, '/chunks', chunks, ('chunks',))
    check_pages(base, '/batches', batches, ('batches',))
    members = batches['batches']
    if members:
        names = [name for batch in members for name in batch['chunks']]
        check(['/chunk/' + name for name in names] == chunks['chunks'], 'Batch membership differs from chunks')
        selected = members[:1] + (members[-1:] if len(members) > 1 else [])
        for batch in selected:
            endpoint = '/batch/' + batch['batch_id']
            check(batch['url'] == endpoint, 'Incorrect batch URL')
            detail = json.loads(expect(base, endpoint))
            check(detail['run_id'] == chunks['run_id'], 'Batch run ID differs')
            check('results' not in detail, 'Batch detail must not expose parallel result arrays')
            expected = [{'chunk': '/chunk/' + n, 'result': '/result/' + n} for n in batch['chunks']]
            check(detail['chunks'] == expected, 'Batch chunk/result pairs differ')
            check_pages(base, endpoint, detail, ('chunks',))
    check(json.loads(expect(base, '/api?limit=1&offset=999999')) == api, 'API catalog was paginated')
    return chunks


def check_export(data, listing, result_name=None, payload=None):
    """Prove export stays complete after paginated discovery, including empty input."""
    with zipfile.ZipFile(io.BytesIO(data)) as exported:
        check(exported.testzip() is None, 'Corrupt export')
        manifest = json.loads(exported.read('ai_analysis_bundle_manifest.json'))
        names = {path.removeprefix('/chunk/') for path in listing['chunks']}
        check(manifest['run_id'] == listing['run_id'], 'Export run ID mismatch')
        check(set(manifest['chunks']) == names, 'Export chunk listing differs')
        sources = {n.removeprefix('ai_analysis_input/') for n in exported.namelist()
                   if n.startswith('ai_analysis_input/') and not n.endswith('/')}
        check(sources == names, 'Export omitted or added source chunks')
        for name in names:
            source = exported.read('ai_analysis_input/' + name)
            check(hashlib.sha256(source).hexdigest() == manifest['chunks'][name], 'Export source checksum mismatch')
        if result_name is not None:
            check(exported.read('results/' + result_name) == payload, 'Export result differs')
        print('Verified export members: ' + ', '.join(exported.namelist()), flush=True)


def free_port():
    with socket.socket() as sock:
        sock.bind(('127.0.0.1', 0))
        return sock.getsockname()[1]


def smoke(app):
    check(app.is_file(), f'Not a file: {app}')
    with app.open('rb') as stream:
        check(stream.readline() == b'#!/usr/bin/env python3\n', 'Missing zipapp shebang')
    check(zipfile.is_zipfile(app), 'Not a readable zipapp')
    check(shutil.which('curl') is not None, 'curl is required')
    with tempfile.TemporaryDirectory(prefix='kcap-ai-smoke-') as temp:
        copy = Path(temp) / 'serve_ai.pyz'
        shutil.copy2(app, copy)
        copy.chmod(copy.stat().st_mode | 0o111)
        port = free_port()
        base = f'http://127.0.0.1:{port}'
        print(f'Starting temporary serve_ai.pyz at {base}', flush=True)
        with open(Path(temp) / 'server.log', 'wb') as log:
            proc = subprocess.Popen([str(copy), '--no-daemon', '--log-file',
                                     str(Path(temp) / 'access.log'), str(port), '127.0.0.1'],
                                    cwd=temp, stdout=log, stderr=subprocess.STDOUT)
            try:
                deadline = time.monotonic() + 10
                while True:
                    if proc.poll() is not None:
                        raise RuntimeError(f'Server exited before readiness: {proc.returncode}')
                    try:
                        code, _ = curl(base, '/chunks')
                        if code == 200:
                            break
                    except (AssertionError, subprocess.TimeoutExpired):
                        pass
                    check(time.monotonic() < deadline, 'Server readiness timed out')
                    time.sleep(0.1)
                print('Server ready; starting HTTP checks', flush=True)

                front_page = expect(base, '/')
                check(bool(front_page.strip()), 'Empty server front page')
                check(expect(base, '/README.md') == front_page, 'Front page aliases differ')
                prompt = expect(base, '/prompt')
                check(bool(prompt.strip()), 'Empty prompt')
                input_schema = expect(base, '/schema/input')
                output_schema = expect(base, '/schema/output')
                check(json.loads(input_schema)['type'] == 'object', 'Invalid input schema')
                check(json.loads(output_schema)['type'] == 'object', 'Invalid output schema')
                with zipfile.ZipFile(copy) as source_archive:
                    expected_version = json.loads(source_archive.read('ai_server_version.json'))
                listing = check_discovery(base, expected_version)
                paths = listing['chunks']
                check(isinstance(paths, list), 'Invalid chunk listing')
                if not paths:
                    check_export(expect(base, '/export', binary=True), listing)
                    print(paint('PASS: empty discovery, pagination and complete export', '32'))
                    return
                check(all(re.fullmatch(r'/chunk/(?:batch_[0-9]{3,}/)?[0-9]+[.]json', path) for path in paths),
                      'Invalid chunk paths')
                name = paths[0].removeprefix('/chunk/')
                source = expect(base, paths[0])
                chunk = json.loads(source)
                check(chunk['run_id'] == listing['run_id'], 'Run ID mismatch')
                check(chunk['source_chunk'] == name, 'Chunk name mismatch')
                check(chunk['total_commits'] == len(chunk['commits']), 'Chunk count mismatch')
                check(chunk['input_schema_checksum'] == hashlib.sha256(input_schema).hexdigest(),
                      'Input schema checksum mismatch')
                check(chunk['output_schema_checksum'] == hashlib.sha256(output_schema).hexdigest(),
                      'Output schema checksum mismatch')
                expect(base, '/chunk/999999999999999999999999.json', 404,
                       reason='unknown chunk is rejected')
                expect(base, '/result/' + name, 404,
                       reason='result is absent before upload')
                for method in ('PUT', 'POST'):
                    expect(base, '/result/' + name, 400, method=method, data=b'{}',
                           reason=f'invalid {method} result is rejected')
                expect(base, '/result/' + name, 404,
                       reason='rejected upload saved nothing')
                result = {
                    'schema_version': '1.0', 'run_id': listing['run_id'],
                    'source_chunk': name, 'input_checksum': hashlib.sha256(source).hexdigest(),
                    'input_schema_checksum': chunk['input_schema_checksum'],
                    'output_schema_checksum': chunk['output_schema_checksum'],
                    'analysis_status': 'partial' if chunk['commits'] else 'complete',
                    'total_commits': len(chunk['commits']), 'analyzed_commits': 0, 'results': {},
                }
                payload = json.dumps(result, sort_keys=True).encode()
                for method in ('PUT', 'POST'):
                    reply = json.loads(expect(base, '/result/' + name, method=method, data=payload))
                    check(reply == {'status': 'ok'}, f'Unexpected {method} response')
                    check(expect(base, '/result/' + name) == payload, 'Result round trip differs')
                archive = expect(base, '/export', binary=True)
                check_export(archive, listing, name, payload)
                print(paint(f'PASS: {len(paths)} chunks; API, batches, pagination, upload, complete export', '32'))
            finally:
                if proc.poll() is None:
                    proc.terminate()
                try:
                    proc.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    proc.wait(timeout=5)
                print('Stopped temporary server', flush=True)


def main():
    if len(sys.argv) != 2:
        print(f'Usage: {Path(sys.argv[0]).name} /path/to/serve_ai.pyz', file=sys.stderr)
        return 2
    try:
        smoke(Path(sys.argv[1]).expanduser().resolve())
    except (AssertionError, RuntimeError, OSError, ValueError, KeyError,
            zipfile.BadZipFile, subprocess.TimeoutExpired) as exc:
        print(paint(f'FAIL: {exc}', '31', enabled=color_enabled(sys.stderr)), file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
