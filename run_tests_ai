#!/usr/bin/env python3
"""Smoke-test a generated serve_ai.pyz over loopback with curl."""
import hashlib
import io
import json
import os
from pathlib import Path
import re
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import zipfile


def check(condition, message):
    if not condition:
        raise AssertionError(message)


def color_enabled(stream=None, environ=None):
    stream = sys.stdout if stream is None else stream
    environ = os.environ if environ is None else environ
    return 'NO_COLOR' not in environ and bool(stream.isatty())


def paint(text, code, *, enabled=None):
    if enabled is None:
        enabled = color_enabled()
    return f'\033[{code}m{text}\033[0m' if enabled else text


def preview(data, limit=160):
    """Bound single-line output while showing readable request/response bytes."""
    text = data.decode('utf-8', errors='replace').replace('\r', '\\r').replace('\n', '\\n')
    return text[:limit] + ('...' if len(text) > limit else '')


def format_exchange(method, path, actual, expected, body, *, data=None, binary=False,
                    reason=None, enabled=None):
    request = f'> {method} {path}'
    if data is not None:
        request += f' | JSON {preview(data)}'
    matched = actual == expected
    label = 'EXPECTED' if matched and expected >= 400 else 'OK' if matched else 'FAIL'
    status = f'< {label} HTTP {actual} (expected {expected})'
    if reason:
        status += f' — {reason}'
    if binary:
        detail = f'{len(body)} bytes (ZIP; contents checked below)'
    elif expected >= 400 and matched:
        detail = f'{len(body)} bytes (expected rejection; HTML body omitted)'
    else:
        detail = f'{len(body)} bytes | {preview(body)}'
    return paint(request, '36', enabled=enabled), paint(f'{status} | {detail}',
        '33' if matched and expected >= 400 else '32' if matched else '31', enabled=enabled)


def curl(base, path, *, method='GET', data=None):
    command = ['curl', '--silent', '--show-error', '--noproxy', '*', '--max-time', '5',
               '--output', '-', '--write-out', '\n%{http_code}', '-X', method]
    if data is not None:
        command += ['-H', 'Content-Type: application/json', '--data-binary', '@-']
    command.append(base + path)
    result = subprocess.run(command, input=data, capture_output=True, timeout=8)
    check(result.returncode == 0, f'curl {method} {path}: {result.stderr.decode(errors="replace")}')
    body, status = result.stdout.rsplit(b'\n', 1)
    return int(status), body


def expect(base, path, status=200, *, method='GET', data=None, binary=False, reason=None):
    code, body = curl(base, path, method=method, data=data)
    request, response = format_exchange(method, path, code, status, body,
        data=data, binary=binary, reason=reason)
    print(request, flush=True)
    print(response, flush=True)
    check(code == status, f'{method} {path}: expected {status}, got {code}: {body[:300]!r}')
    return body


def check_pages(base, endpoint, full, fields):
    """Compare paginated responses with independent slices of the full listing."""
    end = len(full[fields[0]]) + 1
    cases = [('limit=1', 0, 1), ('offset=1', 1, None),
             ('limit=1&offset=1', 1, 1), ('limit=0', 0, None),
             (f'limit=1&offset={end}', end, 1), (f'limit={end}', 0, end)]
    for query, offset, limit in cases:
        page = json.loads(expect(base, endpoint + '?' + query))
        expected = dict(full)
        for field in fields:
            expected[field] = full[field][offset:offset + limit if limit else None]
        check(page == expected, f'Pagination or metadata mismatch: {endpoint}?{query}')

    for query in ('limit=-1&offset=-1', 'limit=bad&offset=bad', 'limit=&offset=',
                  'limit=1.5&offset=1.5', 'limit=1_0', 'limit=1&limit=2',
                  'offset=0&offset=1', 'limti=1', 'limit=1&unknown=2'):
        expect(base, endpoint + '?' + query, status=400, reason='invalid pagination is rejected')


def check_discovery(base, expected_version=None):
    """Check both complete APIs and return the v1 source listing."""
    for path in ('/api', '/contract', '/prompt/analyst', '/schema/input', '/chunks', '/export', '/v1', '/v2'):
        expect(base, path, 404)
    listing = None
    for prefix in ('/v1', '/v2'):
        api = json.loads(expect(base, prefix + '/api'))
        routes = {(r['method'], r['path']): r for r in api['routes']}
        check(all(path.startswith(prefix + '/') for method, path in routes), 'Cross-version or unversioned route advertised')
        check(('GET', prefix + '/api') in routes, 'Catalog must describe itself')
        for path in ('/version', '/contract', '/prompt/<name>', '/schema/<name>'):
            check(('GET', prefix + path) in routes, 'Missing shared document route: ' + path)
        check(all('examples' in r and 'path_parameters' in r and r.get('description') for r in api['routes']), 'Missing API metadata')
        check(json.loads(expect(base, prefix + '/api?limit=1&offset=999')) == api, 'API catalog was paginated')
        version = json.loads(expect(base, prefix + '/version'))
        if expected_version is not None:
            check(version == expected_version, 'Captured tool version differs')
        contract = json.loads(expect(base, prefix + '/contract'))
        check(contract['run_id'] == api['run_id'], 'Contract identity mismatch')
        for entry in contract['assets'].values():
            check(entry['url'].startswith(prefix + '/'), 'Contract link escapes API')
            data = expect(base, entry['url'])
            check(hashlib.sha256(data).hexdigest() == entry['checksum'], 'Document checksum mismatch')
            check(len(data) == entry['bytes'], 'Document size mismatch')
        if prefix == '/v1':
            listing = json.loads(expect(base, prefix + '/chunks'))
            check_pages(base, prefix + '/chunks', listing, ('chunks',))
            for entry in listing['chunks']:
                check(entry['url'] == '/v1/chunk/' + entry['name'], 'Invalid source URL')
                source = json.loads(expect(base, entry['url']))
                check(set(source) == {'run_id', 'commits'} and source['run_id'] == api['run_id'], 'Invalid source document')
        else:
            plan = json.loads(expect(base, prefix + '/plan', method='POST', data=b'{"max_commits":1}'))
            check(plan['run_id'] == api['run_id'], 'Plan identity mismatch')
            for group in plan['groups']:
                data = expect(base, prefix + '/plan/' + plan['plan_id'] + '/' + group['group_id'])
                check(len(data) == group['input_bytes'], 'Plan byte count mismatch')
                check([c['commit'] for c in json.loads(data)['commits']] == group['commits'], 'Plan membership mismatch')
    return listing


def check_export(data, listing, result_name=None, payload=None):
    """Verify complete original source provenance and optional canonical bytes."""
    with zipfile.ZipFile(io.BytesIO(data)) as archive:
        manifest = json.loads(archive.read('ai_analysis_bundle_manifest.json'))
        check(manifest['analysis_id'] == listing['run_id'], 'Export identity mismatch')
        names = {e['name'] for e in listing['chunks']}
        actual = {n.removeprefix('ai_analysis_input/') for n in archive.namelist() if n.startswith('ai_analysis_input/')}
        check(actual == names == set(manifest['chunks']), 'Export omitted or added sources')
        for name in names:
            check(hashlib.sha256(archive.read('ai_analysis_input/' + name)).hexdigest() == manifest['chunks'][name], 'Source checksum mismatch')
        if result_name is not None:
            check(archive.read('results/' + result_name) == payload, 'Export result differs')


def free_port():
    with socket.socket() as sock:
        sock.bind(('127.0.0.1', 0))
        return sock.getsockname()[1]


def smoke(app):
    check(app.is_file(), f'Not a file: {app}')
    with app.open('rb') as stream:
        check(stream.readline() == b'#!/usr/bin/env python3\n', 'Missing zipapp shebang')
    check(zipfile.is_zipfile(app), 'Not a readable zipapp')
    check(shutil.which('curl') is not None, 'curl is required')
    with tempfile.TemporaryDirectory(prefix='kcap-ai-smoke-') as temp:
        copy = Path(temp) / 'serve_ai.pyz'
        shutil.copy2(app, copy)
        copy.chmod(copy.stat().st_mode | 0o111)
        port = free_port()
        base = f'http://127.0.0.1:{port}'
        print(f'Starting temporary serve_ai.pyz at {base}', flush=True)
        with open(Path(temp) / 'server.log', 'wb') as log:
            proc = subprocess.Popen([str(copy), '--no-daemon', '--log-file',
                                     str(Path(temp) / 'access.log'), str(port), '127.0.0.1'],
                                    cwd=temp, stdout=log, stderr=subprocess.STDOUT)
            try:
                deadline = time.monotonic() + 10
                while True:
                    if proc.poll() is not None:
                        raise RuntimeError(f'Server exited before readiness: {proc.returncode}')
                    try:
                        code, _ = curl(base, '/v1/chunks')
                        if code == 200:
                            break
                    except (AssertionError, subprocess.TimeoutExpired):
                        pass
                    check(time.monotonic() < deadline, 'Server readiness timed out')
                    time.sleep(0.1)
                print('Server ready; starting HTTP checks', flush=True)

                check(bool(expect(base, '/').strip()), 'Empty entry guide')
                with zipfile.ZipFile(copy) as source_archive:
                    version = json.loads(source_archive.read('ai_server_version.json'))
                listing = check_discovery(base, version)
                for prefix in ('/v1', '/v2'):
                    expect(base, prefix + '/validate/workflow', 400, method='POST', data=b'{}')
                    expect(base, prefix + '/result', 400, method='POST', data=b'{}')
                    expect(base, prefix + '/result', 405, method='PUT', data=b'{}')
                    inputs = {role: dict(run_id=listing['run_id'], role=role, results={}) for role in ('analyst', 'cve', 'reviewer')}
                    payload = json.dumps(inputs).encode()
                    for role in inputs:
                        expect(base, prefix + '/validate/role/' + role, method='POST', data=json.dumps(inputs[role]).encode())
                    expect(base, prefix + '/validate/workflow', method='POST', data=payload)
                    reply = json.loads(expect(base, prefix + '/result', method='POST', data=payload))
                    check(reply == dict(status='stored', run_id=listing['run_id'], results={}), 'Invalid empty-selection receipt')
                    check_export(expect(base, prefix + '/export', binary=True), listing)
                print(paint('PASS: both APIs, shared documents, delivery, validation and export', '32'))
            finally:
                if proc.poll() is None:
                    proc.terminate()
                try:
                    proc.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    proc.wait(timeout=5)
                print('Stopped temporary server', flush=True)


def main():
    if len(sys.argv) != 2:
        print(f'Usage: {Path(sys.argv[0]).name} /path/to/serve_ai.pyz', file=sys.stderr)
        return 2
    try:
        smoke(Path(sys.argv[1]).expanduser().resolve())
    except (AssertionError, RuntimeError, OSError, ValueError, KeyError,
            zipfile.BadZipFile, subprocess.TimeoutExpired) as exc:
        print(paint(f'FAIL: {exc}', '31', enabled=color_enabled(sys.stderr)), file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
