"""Versioned delivery interfaces over one canonical contribution/result pipeline."""
import copy
import io
import json
import zipfile

from . import server as base
from .canonical import (ROLES, CanonicalStore, assemble_contributions, record_path,
                        record_schema, role_schema, validate_role_document)
from .planning import GroupPlanner, source_document
from .result_store import _decode, _encode

RUN_ID = base.MANIFEST.get('analysis_id')
SCHEMAS, EXPOSED = {}, {}
STORE = PLANS = None


def response_schemas():
    obj, array = base.response_object, base.response_array
    text = dict(type='string')
    identity = dict(type='string', pattern='^[0-9a-f]{64}$')
    sha = dict(type='string', pattern='^[0-9a-f]{40}$')
    positive = dict(type='integer', minimum=1)
    selection = dict(array(sha), uniqueItems=True)
    return {
        'versioned_catalog': obj(run_id=identity, routes=array(dict(type='object')),
            planning_defaults=obj(max_commits_per_group=positive, max_bytes_per_group=positive,
                                  max_groups=dict(type=['integer', 'null'], minimum=1)),
            schema_policy=obj(strict=dict(type='boolean'), extra_fields=dict(enum=['ignore', 'reject'])),
            authentication=obj(required=dict(type='boolean'), scheme=dict(type=['string', 'null'])),
            response_schemas=dict(type='object'), error_responses=dict(type='object'),
            schemas=dict(type='object', additionalProperties=text)),
        'versioned_contract': obj(run_id=identity, assets=dict(type='object', additionalProperties=obj(
            url=text, checksum=identity, bytes=dict(type='integer', minimum=0)))),
        'versioned_role_ack': obj(status=dict(const='valid'), run_id=identity,
            role=dict(enum=list(ROLES))),
        'versioned_workflow_ack': obj(status=dict(const='valid'), run_id=identity, commits=selection),
        'versioned_upload_ack': obj(status=dict(const='stored'), run_id=identity,
            results=dict(type='object', patternProperties={'^[0-9a-f]{40}$': identity},
                         additionalProperties=False)),
        'versioned_chunks': obj(run_id=identity, chunks=array(obj(name=text, url=text))),
        'versioned_plan': obj(run_id=identity, plan_id=identity,
            parameters=obj(max_commits_per_group=positive, max_bytes_per_group=positive,
                           max_groups=dict(type=['integer', 'null'], minimum=1)),
            total_groups=dict(type='integer', minimum=0),
            returned_groups=dict(type='integer', minimum=0), limited=dict(type='boolean'),
            groups=array(obj(group_id=identity, commit_count=positive, input_bytes=positive))),
    }


def reply(self, value):
    self.send_bytes(_encode(value))


def prefix_for(self):
    return '/' + self.path.split('?', 1)[0].split('/')[1]


def catalog(self):
    """Describe this API completely from its executable route registry."""
    prefix = prefix_for(self)
    groups = ['discovery', 'contract', 'sources', 'validation', 'results', 'other']
    entries = []
    choices = dict(prompts=prompt_names(), schemas=sorted(EXPOSED), roles=list(ROLES),
                   chunks=sorted(base.NAMES), shas=sorted(base.SOURCE_INDEX.records))
    for item in base.ROUTES:
        if not item['path'].startswith(prefix + '/') or not callable(getattr(type(self), 'do_' + item['method'], None)):
            continue
        entry = copy.deepcopy({key: value for key, value in item.items() if key not in ('handler', 'matcher')})
        entry.setdefault('group', 'other')
        entry.setdefault('order', 0)
        entry['description'] = entry.get('description') or (item['handler'].__doc__ or '').strip()
        if self.server.auth_credentials is not None:
            entry['responses']['401'] = {'$ref': '#/error_responses/401'}
        if entry.get('request_content_type'):
            entry['request_body'] = dict(required=True, content_type=entry['request_content_type'],
                description='Supply the complete JSON document in the POST body, not a filename or source delivery name.',
                schema={'$ref': entry['request_schema']})
        sources = entry.pop('parameter_sources', {})
        entry['path_parameters'] = {}
        url = entry['path']
        for name in entry['parameters']:
            kind = sources.get(name, 'shas' if name == 'sha' else None)
            values = choices.get(kind, [])
            value = 'analyst' if kind in ('roles', 'prompts') and 'analyst' in values else next(iter(values), None)
            spec = dict(type='string', description='Select a value from this API; never substitute a delivery identity for an analysis identity.', example=value)
            if kind in ('roles', 'prompts', 'schemas'):
                spec['enum'] = list(values)
            entry['path_parameters'][name] = spec
            if value is not None:
                url = url.replace('<' + name + '>', base.urllib.parse.quote(value, safe='/'))
        entry['examples'] = []
        if '<' not in url:
            entry['examples'].append(dict(method=entry['method'], url=url))
            if entry.get('query_parameters'):
                query = '?max_commits_per_group=10&max_groups=1' if entry['path'] == '/v2/plan' else '?limit=1&offset=0'
                entry['examples'].append(dict(method=entry['method'], url=url + query))
        entries.append(entry)
    entries.sort(key=lambda item: (groups.index(item['group']), item['order'], item['path'], item['method']))
    defaults = dict(max_commits_per_group=PLANS.defaults['max_commits'],
                    max_bytes_per_group=PLANS.defaults['max_bytes'], max_groups=None)
    strict = getattr(self.server, 'strict_schema', False)
    reply(self, dict(run_id=RUN_ID, routes=entries, planning_defaults=defaults,
                    schema_policy=dict(strict=strict, extra_fields='reject' if strict else 'ignore'),
                    authentication=dict(required=self.server.auth_credentials is not None,
                        scheme='Basic' if self.server.auth_credentials is not None else None),
                    error_responses=base.error_responses(), response_schemas=base.RESPONSE_SCHEMAS,
                    schemas={name: prefix + '/schema/' + name for name in sorted(EXPOSED)}))


def version(self):
    """Report the tool version captured when this package was generated."""
    reply(self, base.SERVER_VERSION)


def prompt_names():
    return sorted(name.split('/')[1][:-3] for name in base.CONTRACT if name.startswith('prompts/'))


def asset_bytes(path):
    """Use exactly the exposed API schemas when composing a role prompt."""
    if path.startswith('schemas/'):
        name = path.split('/')[1][:-5]
        if name in EXPOSED:
            return _encode(EXPOSED[name])
    return base.ARCHIVE.read('ai_contract/' + path)


def prompt_bytes(name):
    if name in base.BODY_SCHEMAS:
        return base.build_prompt_body(name, asset_bytes)
    return base.ARCHIVE.read('ai_contract/prompts/' + name + '.md')


def prompt(self, name):
    """Read role instructions and exact input/output schemas; extra prompts are served unchanged."""
    if name not in prompt_names():
        self.send_error(404)
        return
    self.send_bytes(prompt_bytes(name))


def contract(self):
    """Discover this API's effective documents with exact served-byte checksums."""
    prefix = prefix_for(self)
    assets = {}
    for name in prompt_names():
        raw = prompt_bytes(name)
        assets['prompts/' + name + '.md'] = dict(url=prefix + '/prompt/' + name,
                                               checksum=base.checksum(raw), bytes=len(raw))
    for name in sorted(EXPOSED):
        raw = _encode(schema_value(name, prefix))
        assets['schemas/' + name + '.json'] = dict(url=prefix + '/schema/' + name,
                                                 checksum=base.checksum(raw), bytes=len(raw))
    reply(self, dict(run_id=RUN_ID, assets=assets))


def schema_value(name, prefix):
    value = copy.deepcopy(EXPOSED[name])
    if name == 'workflow':
        value['properties'] = {role: {'$ref': prefix + '/schema/' + role} for role in ROLES}
    return value


def schema(self, name):
    """Read effective schemas; workflow references stay within this API version."""
    if name not in EXPOSED:
        self.send_error(404)
        return
    reply(self, schema_value(name, prefix_for(self)))


def stored_records(shas=None):
    """Read canonical findings without migration or write side effects."""
    selected = base.SOURCE_INDEX.select(list(base.SOURCE_INDEX.records) if shas is None else shas)
    records = {}
    for sha in selected:
        data = STORE.get(sha)
        if data is not None:
            records[sha] = _decode(data)
    return records


def normalize_document(self, document, role=None):
    """Filter only unknown contract fields; defined values still require validation."""
    server = getattr(self, 'server', None)
    if getattr(server, 'strict_schema', False) or not isinstance(document, dict):
        return document
    ignored = []

    def closed(value, allowed, path):
        if not isinstance(value, dict):
            return copy.deepcopy(value)
        ignored.extend(path + [key] for key in value if key not in allowed)
        return {key: copy.deepcopy(item) for key, item in value.items() if key in allowed}

    def role_document(name, value):
        result = closed(value, ('run_id', 'role', 'results'), [name])
        if isinstance(result, dict) and isinstance(result.get('results'), dict):
            fields = base.result_properties(SCHEMAS[name])
            result['results'] = {sha: closed(item, fields, [name, 'results', sha])
                                 for sha, item in result['results'].items()}
        return result

    if role is None:
        result = closed(document, ROLES, [])
        result = {name: role_document(name, value) for name, value in result.items()}
    else:
        result = role_document(role, document)
    logger = getattr(server, 'access_logger', None)
    if ignored and logger is not None:
        logger.info('SERVER schema_filter ignored_paths=%s', json.dumps(ignored, ensure_ascii=True))
    return result


def contributions(self, group_id=None):
    """Validate three role documents; group submission requires exact full-group coverage."""
    source = None
    if group_id is not None:
        try:
            source = PLANS.group(group_id)
        except KeyError:
            self.send_error(404)
            return
    try:
        _, document = self.read_json()
        document = normalize_document(self, document)
        records = assemble_contributions(document, base.SOURCE_INDEX, SCHEMAS, RUN_ID)
        if source is not None and set(records) != {item['commit'] for item in source['commits']}:
            raise ValueError('Contribution SHA coverage must equal the complete group')
    except (ValueError, UnicodeError, RecursionError) as exc:
        self.close_connection = True
        self.send_error(400, exc)
        return
    path = self.path.split('?', 1)[0]
    if path.endswith('/validate/workflow') or path.startswith('/v2/validate/'):
        reply(self, dict(status='valid', run_id=RUN_ID, commits=sorted(records)))
    else:
        with STORE._lock:
            published = STORE.put_many(records)
        receipts = {sha: published[sha] for sha in sorted(records)}
        reply(self, dict(status='stored', run_id=RUN_ID, results=receipts))


def validate_role(self, role):
    """Apply the active schema policy and validate one role without storing findings."""
    if role not in ROLES:
        self.send_error(404)
        return
    try:
        _, document = self.read_json()
        document = normalize_document(self, document, role)
        validate_role_document(role, document, base.SOURCE_INDEX, SCHEMAS, RUN_ID)
    except (ValueError, UnicodeError, RecursionError) as exc:
        self.close_connection = True
        self.send_error(400, exc)
        return
    reply(self, dict(status='valid', run_id=RUN_ID, role=role))


def result(self, sha):
    """Retrieve an accepted canonical record by full commit SHA; 404 if unassessed."""
    try:
        base.SOURCE_INDEX.chunk_for(sha)
    except ValueError:
        self.send_error(404)
        return
    value = stored_records([sha]).get(sha)
    if value is None:
        self.send_error(404)
        return
    self.send_bytes(_encode(value))


def chunks(self):
    """List packaged v1 delivery URLs without changing analysis identity."""
    reply(self, dict(run_id=RUN_ID, chunks=[dict(name=name, url='/v1/chunk/' + name)
                                          for name in base.listing_page(self.path, sorted(base.NAMES))]))


def chunk(self, name):
    """Read a packaged selection as a grouping-independent source document."""
    if name not in base.NAMES:
        self.send_error(404)
        return
    shas = [item['commit'] for item in base.SOURCE_INDEX.context(name)['commits']]
    reply(self, source_document(base.SOURCE_INDEX, RUN_ID, shas))


def plan(self):
    """Plan implicit source commits using positive per-group limits and optional max_groups."""
    try:
        query = base.urllib.parse.urlsplit(self.path).query
        value = PLANS.plan(PLANS.query_options(query))
    except ValueError as exc:
        self.send_error(400, exc)
        return
    reply(self, value)


def group(self, group_id):
    """Read complete group evidence using only its durable group ID."""
    try:
        value = PLANS.group(group_id)
    except KeyError:
        self.send_error(404)
        return
    reply(self, value)


def export(self):
    """Export provenance and accepted canonical findings as a deterministic ZIP."""
    members = {'ai_analysis_bundle_manifest.json': base.ARCHIVE.read('ai_analysis_bundle_manifest.json')}
    members.update({'ai_contract/' + name: base.ARCHIVE.read('ai_contract/' + name)
                    for name in base.CONTRACT})
    members.update({'ai_analysis_input/' + name: base.SOURCE_INDEX.raw[name] for name in base.NAMES})
    for sha, value in sorted(stored_records().items()):
        members['results/' + record_path(sha)] = _encode(value)
    stream = io.BytesIO()
    with zipfile.ZipFile(stream, 'w') as bundle:
        for name, data in sorted(members.items()):
            info = zipfile.ZipInfo(name, date_time=(1980, 1, 1, 0, 0, 0))
            info.compress_type = zipfile.ZIP_DEFLATED
            info.external_attr = 0o600 << 16
            bundle.writestr(info, data)
    self.send_bytes(stream.getvalue())


def install():
    """Install exactly two self-contained APIs for newly generated packages."""
    global STORE, PLANS
    if STORE is not None:
        return
    if RUN_ID is None:
        raise ValueError("A grouping-independent analysis_id is required")
    SCHEMAS.update({role: json.loads(base.ARCHIVE.read('ai_contract/schemas/' + role + '.json'))
                    for role in ROLES + ('result',)})
    EXPOSED.update({role: role_schema(SCHEMAS[role]) for role in ROLES})
    EXPOSED['result'] = record_schema(SCHEMAS['result'])
    EXPOSED['workflow'] = dict(type='object', additionalProperties=False, required=list(ROLES),
                              properties={role: {} for role in ROLES})
    source = json.loads(base.ARCHIVE.read('ai_contract/schemas/input.json'))
    source['required'] = ['run_id', 'commits']
    source['properties'] = {key: source['properties'][key] for key in source['required']}
    source['additionalProperties'] = False
    source['description'] = 'Trusted analysis identity and selected source commits; delivery groups are not identities.'
    EXPOSED['input'] = source
    for path in base.CONTRACT:
        if path.startswith('schemas/'):
            EXPOSED.setdefault(path.split('/')[1][:-5], json.loads(base.ARCHIVE.read('ai_contract/' + path)))
    store = CanonicalStore(base.RESULTS, base.SOURCE_INDEX, SCHEMAS['result'], RUN_ID)
    plans = GroupPlanner(base.SOURCE_INDEX, RUN_ID, base.RESULTS + '.planning',
                         base.MANIFEST.get('planning'))
    STORE, PLANS = store, plans
    base.RESPONSE_SCHEMAS.update(response_schemas())
    post = dict(request_content_type='application/json', min_body_bytes=1,
                max_body_bytes=base.MAX_RESULT_BYTES)
    for prefix in ('/v1', '/v2'):
        base.route('GET', prefix + '/api', group='discovery',
                   response_schema='#/response_schemas/versioned_catalog')(catalog)
        base.route('GET', prefix + '/version', group='discovery',
                   response_schema='#/response_schemas/version')(version)
        base.route('GET', prefix + '/contract', group='contract',
                   response_schema='#/response_schemas/versioned_contract')(contract)
        base.route('GET', prefix + '/prompt/<name>', 'text/markdown; charset=utf-8',
                   group='contract', parameter_sources={'name': 'prompts'})(prompt)
        base.route('GET', prefix + '/schema/<name>', group='contract',
                   parameter_sources={'name': 'schemas'},
                   response_schema='https://json-schema.org/draft/2020-12/schema')(schema)
        base.route('POST', prefix + '/validate/role/<role>', group='validation',
                   roles=list(ROLES), parameter_sources={'role': 'roles'}, writes_results=False,
                   request_schema=prefix + '/schema/<role>',
                   response_schema='#/response_schemas/versioned_role_ack', **post)(validate_role)
        for suffix in (('/validate/workflow', '/result') if prefix == '/v1' else ()):
            base.route('POST', prefix + suffix, group='validation' if 'validate' in suffix else 'results',
                       writes_results=suffix == '/result', request_schema=prefix + '/schema/workflow',
                       response_schema='#/response_schemas/' + (
                           'versioned_workflow_ack' if 'validate' in suffix else 'versioned_upload_ack'),
                       **post)(contributions)
        result_path = '/result/<sha>' if prefix == '/v1' else '/result/commit/<sha>'
        base.route('GET', prefix + result_path, group='results',
                   response_schema=prefix + '/schema/result')(result)
        base.route('GET', prefix + '/export', 'application/zip', group='results')(export)
    base.route('GET', '/v1/chunks', group='sources', query_parameters=base.LIST_QUERY_PARAMETERS,
               response_schema='#/response_schemas/versioned_chunks')(chunks)
    base.route('GET', '/v1/chunk/<name>', group='sources',
               response_schema='/v1/schema/input', parameter_sources={'name': 'chunks'})(chunk)
    query = {name: dict(type='integer', minimum=0, required=False,
                       description='Empty, 0 or omission uses defaults: 25 commits, 262144 bytes, unlimited groups; configured limits override built-ins.')
             for name in ('max_commits_per_group', 'max_bytes_per_group', 'max_groups')}
    base.route('GET', '/v2/plan', group='sources', writes_results=False,
               query_parameters=query,
               response_schema='#/response_schemas/versioned_plan')(plan)
    base.route('GET', '/v2/group/<group_id>', group='sources',
               response_schema='/v2/schema/input')(group)
    for suffix in ('validate', 'result'):
        base.route('POST', '/v2/' + suffix + '/<group_id>',
                   group='validation' if suffix == 'validate' else 'results',
                   writes_results=suffix == 'result', request_schema='/v2/schema/workflow',
                   response_schema='#/response_schemas/' + (
                       'versioned_workflow_ack' if suffix == 'validate' else 'versioned_upload_ack'),
                   **post)(contributions)
