{
  // ── AI Analysis (v20.1.0) ─────────────────────────────────────────────────────
  // This section enables Stage 08 and checks of configured product AI assets.
  // Set "enabled": false, or drop the section, to disable those operations.
  // Bundled schema correctness checks always run; AI never changes scores.
  // Stage 08 snapshots every selected role prompt and schema.
  // Select sample inputs explicitly; product defaults are under initial-dir/ai.
  "ai": {
    "enabled": true,
    "prompts_dir": "${TOOLDIR}/configs/ai/prompts",
    "front_page_path": "${TOOLDIR}/configs/ai/ai_server_front_page.md",
    "schemas_dir": "${TOOLDIR}/configs/ai/schemas",

    // Stage 08 requires a positive integer (default: 100); 0 is not valid.
    // Numbered input chunks carry identity/checksums in the portable work package.
    // These files must exist (checked by 'validate'); there is no implicit sample lookup.
    "chunk_size": 100,

    // Maximum chunks per batch subfolder (positive integer; default: 10).
    // chunk_size counts commits; batch_size counts chunks.
    "batch_size": 10
  }
}
