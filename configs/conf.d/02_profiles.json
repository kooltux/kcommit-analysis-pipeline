{
  // ── Profiles and rules: v20.0.0 resource-isolation example ────────────────────
  // Sample resources are explicitly selected, including when this config is copied.
  // Product configs may replace these lists with their own directories.
  // Relative directory values use the initial config directory, not this fragment.
  // Names must be unique across selected roots; there is no fallback/override tier.
  "profiles": {
    "profiles_dirs": ["${TOOLDIR}/configs/profiles"],
    // Profile weights scale rule contributions: 100 = full, 50 = half, 0 = disabled.
    "active": {
      "performance":        70,
      "security_fixes":    100,
      "security_features":  90
    }
  },

  // ── Rules ─────────────────────────────────────────────────────────────────
  // Rule directories are configured via rules.rules_dirs.
  // Each sub-directory of a rules directory is one rule set; every rule set
  // may contain: keywords_whitelist.txt, keywords_blacklist.txt,
  //              path_whitelist.txt, path_blacklist.txt,
  //              commit_whitelist.txt, commit_blacklist.txt
  // Default search path when rules.rules_dirs is omitted: ${CONFIGDIR}/rules
  "rules": {
    "rules_dirs": ["${TOOLDIR}/configs/rules"]
  }
}
