{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Final assembled assessment",
  "description": "One source-bound document per chunk. Cross-document identity, coverage, array-length and assembly-preservation checks are additional validation gates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","run_id","source_chunk","input_checksum","input_schema_checksum","output_schema_checksum","analysis_status","total_commits","analyzed_commits","results"],
  "properties": {
    "schema_version": {"type": "string","const": "1.0"},
    "run_id": {"type": "string","pattern": "^[0-9a-f]{64}$"},
    "source_chunk": {"type": "string","pattern": "^(?:batch_[0-9]{3,}/)?[0-9]+[.]json$"},
    "input_checksum": {"type": "string","pattern": "^[0-9a-f]{64}$","description": "Exact source-byte SHA-256 supplied by trusted server metadata."},
    "input_schema_checksum": {"type": "string","pattern": "^[0-9a-f]{64}$"},
    "output_schema_checksum": {"type": "string","pattern": "^[0-9a-f]{64}$","description": "Shared final result.json checksum, not the role-specific schema checksum."},
    "analysis_status": {"type": "string","enum": ["complete","partial"]},
    "total_commits": {"type": "integer","minimum": 0},
    "analyzed_commits": {"type": "integer","minimum": 0},
    "results": {
      "type": "object",
      "propertyNames": {"pattern": "^[0-9a-f]{40}$"},
      "additionalProperties": {"$ref": "#/$defs/assessment"}
    }
  },
  "$defs": {
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ai_is_security_fix","ai_is_bug_fix","ai_is_performance_enhancement","ai_is_new_feature","ai_is_new_security_feature","ai_categorisation_rationale","ai_risks_if_not_backported","ai_impact_on_product","ai_impact_description","ai_backport_effort","ai_backport_effort_reason","ai_cve_ids","ai_cve_probabilities","ai_backport_recommendation","ai_summary","rv_agreement","rv_notes","rv_recommendation"],
      "properties": {
        "ai_is_security_fix": {"type": "boolean","description": "Commit fixes a security vulnerability according to available evidence."},
        "ai_is_bug_fix": {"type": "boolean","description": "Commit fixes a functional bug; may also be a security fix."},
        "ai_is_performance_enhancement": {"type": "boolean","description": "Commit primarily improves performance."},
        "ai_is_new_feature": {"type": "boolean","description": "Commit adds a new feature."},
        "ai_is_new_security_feature": {"type": "boolean","description": "Commit adds a security capability rather than repairing a vulnerability."},
        "ai_categorisation_rationale": {"type": "string","description": "Short evidence-based rationale for the classifications."},
        "ai_risks_if_not_backported": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string","enum": ["security_vulnerability","system_stability","data_corruption","performance_degradation","missing_feature","compliance_violation","none"]},
          "description": "Product risks of omitting this backport; none must be used alone."
        },
        "ai_impact_on_product": {"type": "string","enum": ["critical","high","medium","low","none"],"description": "Expected impact on this product, not general upstream severity."},
        "ai_impact_description": {"type": "string","description": "Evidence-based product impact assessment."},
        "ai_backport_effort": {"type": "string","enum": ["very_easy","easy","moderate","hard","very_hard"],"description": "Estimated engineering effort; not a cherry-pick test result."},
        "ai_backport_effort_reason": {"type": "string","description": "Brief reason for the effort estimate including known dependencies."},
        "ai_cve_ids": {
          "type": "array",
          "items": {"type": "string","pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"},
          "description": "CVE IDs explicitly supported by the input; no inferred or invented identifiers."
        },
        "ai_cve_probabilities": {
          "type": "array",
          "items": {"type": "integer","minimum": 0,"maximum": 100},
          "description": "Estimated relevance percentages corresponding positionally to ai_cve_ids; empty if no CVEs."
        },
        "ai_backport_recommendation": {"type": "string","enum": ["strong_yes","yes","maybe","no","strong_no"],"description": "Advisory recommendation for human review."},
        "ai_summary": {"type": "string","description": "Concise evidence and rationale for the recommendation."},
        "rv_agreement": {"type": "string","enum": ["agree","disagree"]},
        "rv_notes": {
          "type": ["array","null"],
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string","pattern": "^(?:ai_is_security_fix|ai_is_bug_fix|ai_is_performance_enhancement|ai_is_new_feature|ai_is_new_security_feature|ai_categorisation_rationale|ai_risks_if_not_backported|ai_impact_on_product|ai_impact_description|ai_backport_effort|ai_backport_effort_reason|ai_cve_ids|ai_cve_probabilities|ai_backport_recommendation|ai_summary): \\[(?:minor|moderate|strong|complete)\\] - [ -~]+ -> [ -~]+ \\([ -~]+\\)(?![\\s\\S])"}
        },
        "rv_recommendation": {
          "type": ["array","null"],
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string","pattern": "^(?:ai_is_security_fix|ai_is_bug_fix|ai_is_performance_enhancement|ai_is_new_feature|ai_is_new_security_feature|ai_categorisation_rationale|ai_risks_if_not_backported|ai_impact_on_product|ai_impact_description|ai_backport_effort|ai_backport_effort_reason|ai_cve_ids|ai_cve_probabilities|ai_backport_recommendation|ai_summary): use [ -~]+(?![\\s\\S])"}
        }
      },
      "allOf": [{"if": {"properties": {"rv_agreement": {"const": "agree"}},"required": ["rv_agreement"]},"then": {"properties": {"rv_notes": {"type": "null"},"rv_recommendation": {"type": "null"}}},"else": {"properties": {"rv_notes": {"type": "array"},"rv_recommendation": {"type": "array"}}}}]
    }
  }
}
