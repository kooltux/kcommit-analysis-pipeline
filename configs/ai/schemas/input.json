{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI analysis source chunk",
  "type": "object",
  "properties": {
    "schema_version": {"type": "string","description": "AI exchange contract version."},
    "pipeline_version": {"type": "string","description": "Version of the pipeline that generated this input."},
    "run_id": {"type": "string","description": "SHA-256 identity of the source data and effective contracts."},
    "source_chunk": {"type": "string","description": "Relative chunk path including batch folder; legacy numbered basenames are accepted."},
    "input_schema_checksum": {"type": "string","description": "SHA-256 checksum of the input schema bytes."},
    "output_schema_checksum": {"type": "string","description": "SHA-256 checksum of the output schema bytes."},
    "total_commits": {"type": "integer","minimum": 0,"description": "Number of commits in this chunk."},
    "chunk_info": {
      "type": "object",
      "description": "Position in the complete source set.",
      "properties": {
        "chunk_number": {"type": "integer","minimum": 0,"description": "One-based chunk number."},
        "total_chunks": {"type": "integer","minimum": 0,"description": "Number of chunks in the bundle."},
        "start_index": {"type": "integer","minimum": 0,"description": "Zero-based inclusive first index."},
        "end_index": {"type": "integer","minimum": 0,"description": "Zero-based exclusive last index."},
        "batch_number": {"type": "integer","minimum": 1},
        "total_batches": {"type": "integer","minimum": 1},
        "chunk_in_batch": {"type": "integer","minimum": 1}
      },
      "required": ["chunk_number","total_chunks","start_index","end_index"],
      "additionalProperties": false
    },
    "commits": {
      "type": "array",
      "description": "Commit records selected by prefilter.",
      "items": {
        "type": "object",
        "properties": {
          "commit": {"type": "string","description": "commit from the source commit.","pattern": "^[0-9a-f]{40}$"},
          "subject": {"type": "string","description": "subject from the source commit."},
          "author_name": {"type": "string","description": "author name from the source commit."},
          "author_email": {"type": "string","description": "author email from the source commit."},
          "author_org": {"type": "string","description": "author org from the source commit."},
          "body": {"type": "string","description": "body from the source commit."},
          "author_time": {"type": "integer","description": "Unix author timestamp in seconds."},
          "files": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Changed source paths."
          },
          "stats": {"type": "object","additionalProperties": true,"description": "Source size indicators."},
          "meta": {"type": "object","additionalProperties": true,"description": "Message annotation flags."},
          "product_evidence": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Product relevance evidence tags."
          }
        },
        "required": ["commit","subject","author_name","author_email","author_org","author_time","body","files","stats","meta","product_evidence"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version","pipeline_version","run_id","source_chunk","input_schema_checksum","output_schema_checksum","total_commits","chunk_info","commits"],
  "additionalProperties": false
}
