{
  // ───────────────────────────────────────────────────────────────────
  // kcommit-analysis-pipeline — ARM embedded full example config
  //
  // This configuration is split into fragments under conf.d/ for clarity.
  // Each fragment contains one logical section with its documentation.
  // v20.0.0: all relative includes use this initial file's directory, even nested.
  // Copy this file and conf.d/ together when relocating the example.
  // Resource fragments explicitly select samples under ${TOOLDIR}/configs/;
  // replace those selections with product resources when adapting this example.
  //
  // Variable expansion: ${VAR} is expanded in all string values.
  // Available variables:
  //   WORKSPACE  – external workspace root (from shell environment)
  //   TOOLDIR    – pipeline repository root (auto-set by the loader)
  //   CONFIGDIR  – directory containing this config file (auto-set)
  //   CWD        – current working directory
  // ────────────────────────────────────────────────────────────────

  "include": [
    "conf.d/00_vars_paths.json",
    "conf.d/01_kernel.json",
    "conf.d/02_profiles.json",
    "conf.d/03_filter.json",
    "conf.d/04_collect.json",
    "conf.d/05_history_mapping.json",
    "conf.d/06_reports.json",
    "conf.d/07_ai.json"
  ]
}
